<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HSMessage</AssemblyName>
    <RootNamespace>HSMessage</RootNamespace>
    <Version>1.3.0</Version>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Override on the command line if Hearthstone lives somewhere else:
         dotnet build -p:HearthstoneDir="D:\Games\Hearthstone" -->
    <HearthstoneDir Condition="'$(HearthstoneDir)' == ''">C:\Program Files (x86)\Hearthstone</HearthstoneDir>
    <ManagedDir>$(HearthstoneDir)\Hearthstone_Data\Managed</ManagedDir>

    <!-- Compile against a local copy of BepInEx under lib\, fetched by
         build.ps1. Keeps building free of admin rights: nothing needs to be
         installed into Program Files just to produce the DLL. -->
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(MSBuildProjectDirectory)\lib\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplies net472 reference assemblies without needing Visual Studio
         or a Windows SDK targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- All of these ship with BepInEx or the game. Private=false keeps them
         out of the build output: the plugin is a single loose DLL. -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The old monolithic facade. Contains no code of its own, but BepInEx's
         BaseUnityPlugin is compiled against it, so it must be referenced for
         MonoBehaviour to resolve. It type-forwards into the modules below. -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="WarnOnMissingRefs" BeforeTargets="BeforeBuild">
    <Warning Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')"
             Text="BepInEx not found at $(BepInExCoreDir). Run build.ps1, which fetches it into lib\." />
    <Warning Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
             Text="Unity assemblies not found at $(ManagedDir). Pass -p:HearthstoneDir=... to point at your install." />
  </Target>

</Project>
